            ]
          },
          "retired": {
            "text": "Me? I'm retired. Very recently retired. If anyone asks, you never saw me."
          },
          "node-yarotx": {
            "text": "Dozens. Are you really going in alone?",
            "next": "node-ufktjp"
          },
